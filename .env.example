# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# BLS API key (optional) — register at https://data.bls.gov/registrationEngine/
# Without a key, BLS limits requests to 25/day. With a key, you get 500/day.
BLS_API_KEY=

# Admin dashboard password (choose a strong random string)
ADMIN_PASSWORD=

# Base URL used for hreflang and OG image generation (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://inflationclock.com

# FRED API — free key from https://fred.stlouisfed.org/docs/api/api_key.html
# Enables live US CPI data on the results page
FRED_API_KEY=

# Web Push / VAPID keys — generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser for push subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
